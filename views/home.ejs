<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= mytitle %></title>
  
  <!-- ربط ملف الـ CSS الموجود في مجلد public -->
  <link rel="stylesheet" href="/Mystyle.css" />
  
  <style>
    input, button {
      font-size: 33px;
    }
  </style>
</head>
<body>

  <h1>What is ur UserName?</h1>
  
  <form action="/" method="post">
    <input name="userNameee" type="text" />
    <br />
    <br />
    <button type="submit">Send to DB</button>
  </form>

  <!-- التحقق من وجود بيانات قبل طباعتها لتجنب الأخطاء -->
  <% if (arr && arr.length > 0) { %>
    <h1>your name is <%= arr.at(-1).userNameee %></h1>
  <% } %>

</body>
</html>